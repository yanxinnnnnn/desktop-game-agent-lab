{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fwj:v1.1:action-intent",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "intent_id": {
      "$ref": "urn:fwj:v1.1:common#/$defs/sha256"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 0
    },
    "proposed_by": {
      "enum": [
        "planner",
        "operator"
      ]
    },
    "kind": {
      "enum": [
        "click_semantic",
        "key",
        "hover_probe"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "semantic_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "semantic_id",
        "label"
      ],
      "additionalProperties": false
    },
    "resolved_point": {
      "$ref": "urn:fwj:v1.1:common#/$defs/point"
    },
    "origin_observation": {
      "type": "object",
      "properties": {
        "observation_id": {
          "$ref": "urn:fwj:v1.1:common#/$defs/ulid"
        },
        "observation_seq": {
          "type": "integer",
          "minimum": 0
        },
        "captured_at": {
          "$ref": "urn:fwj:v1.1:common#/$defs/timestamp"
        },
        "window": {
          "$ref": "urn:fwj:v1.1:common#/$defs/origin_window"
        }
      },
      "required": [
        "observation_id",
        "observation_seq",
        "captured_at",
        "window"
      ],
      "additionalProperties": false
    },
    "key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "urn:fwj:v1.1:common#/$defs/assertion"
      },
      "uniqueItems": true
    },
    "expected_postcondition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "risk": {
      "enum": [
        "reversible",
        "irreversible"
      ]
    },
    "requires_human_approval": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "urn:fwj:v1.1:common#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "urn:fwj:v1.1:common#/$defs/timestamp"
    },
    "ttl_ms": {
      "type": "integer",
      "minimum": 1
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "intent_id",
    "attempt_no",
    "proposed_by",
    "kind",
    "target",
    "resolved_point",
    "origin_observation",
    "key",
    "preconditions",
    "expected_postcondition",
    "risk",
    "requires_human_approval",
    "created_at",
    "expires_at",
    "ttl_ms",
    "state_revision"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "risk": {
            "const": "irreversible"
          }
        }
      },
      "then": {
        "properties": {
          "requires_human_approval": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "key"
          }
        }
      },
      "then": {
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "key": {
            "type": "null"
          }
        }
      }
    }
  ]
}
